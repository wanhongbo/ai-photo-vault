            { "type": "text", "content": "✓  No watermarks on shared photos", "fontFamily": "Inter", "fontSize": 14, "fill": "#F5F8FF", "width": "fill_container" },
            { "type": "text", "content": "✓  AI privacy scan & cleanup", "fontFamily": "Inter", "fontSize": 14, "fill": "#F5F8FF", "width": "fill_container" },
            { "type": "text", "content": "✓  Local encrypted backup & restore", "fontFamily": "Inter", "fontSize": 14, "fill": "#F5F8FF", "width": "fill_container" }
          ]
        },
        {
          "type": "frame",
