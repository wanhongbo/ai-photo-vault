          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "name": "Close Button",
              "width": 44,
              "height": 44,
              "fill": "#1A2230",
              "stroke": "#2E3A4D",
              "strokeWidth": 1,
              "cornerRadius": 22,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                { "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "x", "width": 20, "height": 20, "fill": "#8A94A8" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "name": "Hero",
          "layout": "vertical",
          "width": "fill_container",
          "height": "fit_content",
          "gap": 10,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "name": "Crown Ring",
              "width": 64,
              "height": 64,
              "cornerRadius": 32,
              "stroke": "#E8C547",
              "strokeWidth": 2,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                { "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "crown", "width": 30, "height": 30, "fill": "#FFE08A" }
              ]
            },
            { "type": "text", "content": "LumaNox Pro", "fontFamily": "Inter", "fontSize": 26, "fontWeight": "700", "fill": "#F5F8FF", "textAlignHorizontal": "center", "width": "fill_container" },
            { "type": "text", "content": "Unlock all privacy features", "fontFamily": "Inter", "fontSize": 14, "fill": "#8A94A8", "textAlignHorizontal": "center", "width": "fill_container", "textGrowth": "fixed-width" }
          ]
        },
        {
          "type": "frame",
          "name": "Trigger Context",
          "layout": "horizontal",
          "width": "fill_container",
          "height": "fit_content",
          "gap": 10,
