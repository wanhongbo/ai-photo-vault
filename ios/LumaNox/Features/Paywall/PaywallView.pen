{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "name": "PaywallView",
      "layout": "vertical",
      "width": 393,
      "height": 852,
      "clip": true,
      "fill": {
        "type": "gradient",
        "gradientType": "linear",
        "rotation": 180,
        "colors": [
          { "color": "#070A10", "position": 0 },
          { "color": "#000000", "position": 1 }
        ]
      },
      "padding": [54, 22, 0, 22],
      "gap": 18,
      "children": [
        {
          "type": "frame",
          "name": "Header",
