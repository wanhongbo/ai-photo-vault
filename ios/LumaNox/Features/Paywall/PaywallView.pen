          "cornerRadius": 12,
          "padding": [12, 12, 12, 12],
          "children": [
            { "type": "text", "content": "                  Free        LumaNox Pro", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "600", "fill": "#7E8AA0", "width": "fill_container" },
            { "type": "text", "content": "Private Storage    50              ∞", "fontFamily": "Inter", "fontSize": 13, "fill": "#F5F8FF", "width": "fill_container" },
            { "type": "text", "content": "AI Features        10/mo           ∞", "fontFamily": "Inter", "fontSize": 13, "fill": "#F5F8FF", "width": "fill_container" },
            { "type": "text", "content": "Encrypted Backup   1               ∞", "fontFamily": "Inter", "fontSize": 13, "fill": "#F5F8FF", "width": "fill_container" },
            { "type": "text", "content": "Watermark-free     —               ✓", "fontFamily": "Inter", "fontSize": 13, "fill": "#F5F8FF", "width": "fill_container" }
          ]
        },
        {
          "type": "frame",
          "name": "Sticky Purchase Bar",
          "layout": "vertical",
          "width": 393,
          "height": 190,
          "gap": 8,
          "fill": "#000000",
          "padding": [24, 22, 8, 22],
