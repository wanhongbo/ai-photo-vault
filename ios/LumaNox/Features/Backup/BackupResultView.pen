{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "screen_backup_result",
      "name": "BackupResultView",
      "layout": "vertical",
      "fill": "#05080D",
      "x": 0,
      "y": 0,
      "width": 393,
      "height": 852,
      "padding": 16,
      "gap": 18,
      "children": [
        {
          "type": "frame",
          "id": "backup_result_nav",
          "layout": "horizontal",
          "fill": "transparent",
          "width": 361,
          "height": 52,
          "gap": 12,
          "alignItems": "center",
          "children": [
            { "type": "text", "id": "backup_result_back", "content": "‹", "fontFamily": "Inter", "fontSize": 17, "fontWeight": "600", "fill": "#EAF1FF", "width": 32 },
            { "type": "text", "id": "backup_result_title", "content": "备份完成", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "600", "fill": "#EAF1FF", "width": 300 }
          ]
        },
        {
          "type": "frame",
          "id": "backup_result_card",
          "name": "Result card",
          "layout": "vertical",
          "alignItems": "center",
          "fill": "#0C1523",
          "width": 361,
          "padding": 22,
          "gap": 12,
          "cornerRadius": 20,
          "stroke": { "fill": "#223247", "thickness": 1 },
          "children": [
            { "type": "text", "id": "backup_result_icon", "content": "✓", "fontFamily": "Inter", "fontSize": 36, "fontWeight": "700", "fill": "#21C277", "width": 317 },
            { "type": "text", "id": "backup_result_success", "content": "备份完成", "fontFamily": "Inter", "fontSize": 22, "fontWeight": "700", "fill": "#EAF1FF", "width": 317 },
            { "type": "text", "id": "backup_result_stats", "content": "已备份 128 项，共 36.4 MB", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "400", "fill": "#8EA2C0", "width": 317 },
            { "type": "text", "id": "backup_result_hint", "content": "备份包已生成，请保存到「文件」或安全位置后再离开。", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500", "fill": "#8EA2C0", "width": 317 }
          ]
        },
        { "type": "frame", "id": "backup_result_save", "name": "Save encrypted file button", "width": 361, "height": 54, "cornerRadius": 16, "fill": "#4A9EFF" },
        { "type": "frame", "id": "backup_result_done", "name": "Return button", "width": 361, "height": 48, "cornerRadius": 14, "fill": "#1A202C", "stroke": { "fill": "#223247", "thickness": 1 } }
      ]
    }
  ]
}
