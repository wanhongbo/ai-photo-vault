{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "name": "ImportOriginalsPreferenceView",
      "layout": "vertical",
      "width": 393,
      "height": 852,
      "clip": true,
      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 180, "colors": [{ "color": "#0B1324", "position": 0 }, { "color": "#05080D", "position": 1 }] },
      "padding": [54, 16, 34, 16],
      "gap": 20,
      "children": [
        { "type": "frame", "name": "Navigation", "layout": "horizontal", "width": "fill_container", "height": 44, "gap": 12, "alignItems": "center", "children": [{ "type": "frame", "layout": "horizontal", "width": 44, "height": 44, "cornerRadius": 14, "fill": "#0E1726", "justifyContent": "center", "alignItems": "center", "children": [{ "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "chevron-left", "width": 22, "height": 22, "fill": "#EAF1FF" }] }, { "type": "text", "content": "Import originals", "fontFamily": "Inter", "fontSize": 22, "fontWeight": "700", "fill": "#EAF1FF", "width": "fill_container", "textGrowth": "fixed-width" }] },
        { "type": "frame", "layout": "vertical", "width": "fill_container", "gap": 8, "children": [{ "type": "text", "content": "After files are added to the vault", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "700", "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }, { "type": "text", "content": "Choose what LumaNox should do with the original items in Photos after encrypted copies are safely created.", "fontFamily": "Inter", "fontSize": 14, "fontWeight": "500", "lineHeight": 1.35, "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }] },
        {
          "type": "frame",
          "name": "Preference choices",
          "layout": "vertical",
          "width": "fill_container",
          "gap": 10,
          "children": [
            { "type": "frame", "layout": "horizontal", "width": "fill_container", "height": 86, "gap": 12, "fill": "#0C1523", "cornerRadius": 14, "padding": [12, 14, 12, 14], "alignItems": "center", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 }, "children": [{ "type": "frame", "layout": "horizontal", "width": 38, "height": 38, "cornerRadius": 13, "fill": "#14243A", "stroke": { "fill": "#223247", "thickness": 1 }, "justifyContent": "center", "alignItems": "center", "children": [{ "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "message-circle", "width": 20, "height": 20, "fill": "#4A9EFF" }] }, { "type": "frame", "layout": "vertical", "width": "fill_container", "gap": 4, "children": [{ "type": "text", "content": "Ask each time", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "700", "fill": "#EAF1FF", "width": "fill_container", "textGrowth": "fixed-width" }, { "type": "text", "content": "Show the import confirmation sheet before handling Photos originals.", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500", "lineHeight": 1.3, "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }] }, { "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "check", "width": 24, "height": 24, "fill": "#4A9EFF" }] },
            { "type": "frame", "layout": "horizontal", "width": "fill_container", "height": 86, "gap": 12, "fill": "#0C1523", "cornerRadius": 14, "padding": [12, 14, 12, 14], "alignItems": "center", "stroke": { "fill": "#223247", "thickness": 1 }, "children": [{ "type": "frame", "layout": "horizontal", "width": 38, "height": 38, "cornerRadius": 13, "fill": "#14243A", "stroke": { "fill": "#223247", "thickness": 1 }, "justifyContent": "center", "alignItems": "center", "children": [{ "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "images", "width": 20, "height": 20, "fill": "#8EA2C0" }] }, { "type": "frame", "layout": "vertical", "width": "fill_container", "gap": 4, "children": [{ "type": "text", "content": "Keep originals in Photos", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "700", "fill": "#EAF1FF", "width": "fill_container", "textGrowth": "fixed-width" }, { "type": "text", "content": "Import encrypted copies and leave the system Photos library unchanged.", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500", "lineHeight": 1.3, "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }] }] },
            { "type": "frame", "layout": "horizontal", "width": "fill_container", "height": 86, "gap": 12, "fill": "#0C1523", "cornerRadius": 14, "padding": [12, 14, 12, 14], "alignItems": "center", "stroke": { "fill": "#223247", "thickness": 1 }, "children": [{ "type": "frame", "layout": "horizontal", "width": 38, "height": 38, "cornerRadius": 13, "fill": "#301725", "stroke": { "fill": "#FF437266", "thickness": 1 }, "justifyContent": "center", "alignItems": "center", "children": [{ "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "trash-2", "width": 20, "height": 20, "fill": "#FF4372" }] }, { "type": "frame", "layout": "vertical", "width": "fill_container", "gap": 4, "children": [{ "type": "text", "content": "Delete originals after import", "fontFamily": "Inter", "fontSize": 16, "fontWeight": "700", "fill": "#FF4372", "width": "fill_container", "textGrowth": "fixed-width" }, { "type": "text", "content": "After import succeeds, request Photos deletion for the selected originals.", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500", "lineHeight": 1.3, "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }] }] }
          ]
        },
        { "type": "frame", "layout": "horizontal", "width": "fill_container", "cornerRadius": 14, "fill": "#0F1D31", "padding": [12, 12, 12, 12], "gap": 12, "stroke": { "fill": "#4A9EFF47", "thickness": 1 }, "children": [{ "type": "frame", "layout": "horizontal", "width": 32, "height": 32, "cornerRadius": 10, "fill": "#4A9EFF1F", "stroke": { "fill": "#4A9EFF38", "thickness": 1 }, "justifyContent": "center", "alignItems": "center", "children": [{ "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "info", "width": 18, "height": 18, "fill": "#4A9EFF" }] }, { "type": "text", "content": "Vault copies are created first. If Photos permission is limited or deletion fails, originals remain in Photos and the import is marked complete.", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500", "lineHeight": 1.35, "fill": "#8EA2C0", "width": "fill_container", "textGrowth": "fixed-width" }] }
      ]
