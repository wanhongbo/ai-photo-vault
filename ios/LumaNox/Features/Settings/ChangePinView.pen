{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "screen_change_pin",
      "name": "ChangePinView",
      "layout": "none",
      "width": 393,
      "height": 852,
      "clip": true,
      "fill": {
        "type": "gradient",
        "gradientType": "linear",
        "rotation": 180,
        "colors": [
          { "color": "#0B1324", "position": 0 },
          { "color": "#05080D", "position": 1 }
        ]
      },
      "children": [
        {
          "type": "frame",
          "id": "change_pin_nav",
          "name": "Navigation",
          "layout": "horizontal",
          "x": 16,
          "y": 54,
          "width": 361,
          "height": 44,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "change_pin_back",
              "layout": "none",
              "width": 44,
              "height": 44,
              "fill": "#0E1726CC",
              "cornerRadius": 14,
              "children": [
                {
                  "type": "icon_font",
                  "id": "change_pin_back_icon",
                  "iconFontFamily": "lucide",
                  "iconFontName": "chevron-left",
                  "x": 12,
                  "y": 12,
                  "width": 20,
                  "height": 20,
                  "fill": "#EAF1FF"
                }
              ]
            },
            {
              "type": "text",
              "id": "change_pin_title",
              "content": "修改 PIN",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "#EAF1FF",
              "textAlign": "center",
              "textGrowth": "fixed-width",
              "width": 273
            },
            {
              "type": "rectangle",
              "id": "change_pin_nav_spacer",
              "width": 44,
              "height": 44,
              "fill": "transparent"
            }
          ]
        },
        {
          "type": "frame",
          "id": "change_pin_copy",
          "name": "Step copy",
          "layout": "vertical",
          "x": 16,
          "y": 122,
          "width": 361,
          "height": "fit_content",
          "fill": "transparent",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "change_pin_subtitle",
              "content": "请输入当前 6 位 PIN，验证通过后才能设置新 PIN。",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "400",
              "fill": "#8EA2C0",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "change_pin_step",
              "content": "验证当前 PIN",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "500",
              "fill": "#8EA2C0D9",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "change_pin_dots",
          "layout": "horizontal",
          "x": 136,
          "y": 208,
          "width": 121,
          "height": 14,
          "fill": "transparent",
          "gap": 12,
          "alignItems": "center",
          "justifyContent": "center",
          "children": [
            { "type": "ellipse", "id": "pin_dot_1", "width": 12, "height": 12, "fill": "#4A9EFF", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } },
            { "type": "ellipse", "id": "pin_dot_2", "width": 12, "height": 12, "fill": "#4A9EFF", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } },
            { "type": "ellipse", "id": "pin_dot_3", "width": 12, "height": 12, "fill": "transparent", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } },
            { "type": "ellipse", "id": "pin_dot_4", "width": 12, "height": 12, "fill": "transparent", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } },
            { "type": "ellipse", "id": "pin_dot_5", "width": 12, "height": 12, "fill": "transparent", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } },
            { "type": "ellipse", "id": "pin_dot_6", "width": 12, "height": 12, "fill": "transparent", "stroke": { "fill": "#4A9EFF", "thickness": 1.5 } }
          ]
        },
