{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "splash_view",
      "name": "SplashView - centered launch stack",
      "layout": "none",
      "width": 393,
      "height": 852,
      "clip": true,
      "fill": {
        "type": "gradient",
        "gradientType": "linear",
        "rotation": 180,
        "colors": [
          { "color": "#0B1324", "position": 0 },
          { "color": "#05080D", "position": 1 }
        ]
      },
      "children": [
        {
          "type": "frame",
          "id": "splash_content",
          "name": "Centered launch content",
          "layout": "vertical",
          "x": 49,
          "y": 278,
          "width": 295,
          "height": "fit_content",
          "gap": 0,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "splash_app_logo",
              "name": "App icon logo",
              "width": 104,
              "height": 104,
              "clip": true,
              "cornerRadius": 28,
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "../../Resources/Assets.xcassets/AppIcon.appiconset/Icon-App-1024x1024@1x.png",
                "mode": "fill"
              },
              "stroke": {
                "thickness": 1,
                "fill": "#4A9EFF57"
              },
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "#4A9EFF4D",
                "offset": { "x": 0, "y": 0 },
                "blur": 34
              }
            },
            {
              "type": "text",
              "id": "splash_app_name",
              "content": "LumaNox",
              "fontFamily": "Inter",
              "fontSize": 42,
              "fontWeight": "800",
              "letterSpacing": 0,
              "fill": "#EAF1FF",
              "height": 51,
              "margin": [30, 0, 0, 0]
            },
            {
              "type": "text",
              "id": "splash_tagline",
              "content": "私密 · 加密 · 只属于你",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "500",
              "letterSpacing": 0,
              "fill": "#8EA2C0",
              "height": 25,
              "margin": [12, 0, 0, 0]
            },
            {
              "type": "frame",
              "id": "splash_progress_track",
              "name": "Progress track",
              "layout": "none",
              "width": 446,
              "height": 4,
              "fill": "#223247",
              "cornerRadius": 2,
              "margin": [58, 0, 0, 0],
              "children": [
                {
                  "type": "rectangle",
                  "id": "splash_progress_fill",
                  "name": "Progress fill",
                  "x": 0,
                  "y": 0,
                  "width": 446,
                  "height": 4,
                  "fill": "#4A9EFF",
                  "cornerRadius": 2
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
